{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // Claude Code (CLAUDE.md) と Codex (AGENTS.md) を .rulesync/ から生成する。生成物は直接編集しない。
  "targets": ["claudecode", "codexcli"],
  "features": ["rules", "skills"],
  "outputRoots": ["."],
  // 生成ディレクトリ配下の管理外ファイルを削除する（source の削除・改名の残骸防止）
  "delete": true,
  // source にタグは付けない。固定は rulesync.lock が担い、更新は `rulesync install --update`
  "sources": [
    {
      "source": "sugurutakahashi-1234/ai-rules",
      // skill-layering: スキル・ルールを足す・直すときの置き場所と、共有スキルを変える前の影響確認
      "rules": ["language-and-commits", "git-safety", "japanese-writing", "skill-layering"],
      // design-compare: 文書の構成案を 1 枚の比較 HTML にして選ぶ（グローバルには置かない手順型スキル）
      // motion-video: モーショングラフィックス動画を本人と作る進め方と道具（HyperFrames と組）。この題材だけの決めはリポジトリの skillsheet-video
      "skills": ["design-compare", "motion-video"]
    },
    {
      // 動画を HTML と GSAP で組んで MP4 にする。HyperFrames 自身のスキル更新は mise.toml の HYPERFRAMES_SKIP_SKILLS で止め、更新は rulesync に任せる。
      // ファイル数が多く、匿名の取り込みは GitHub の回数制限に当たるので `GITHUB_TOKEN=$(gh auth token) bun run rulesync` で取る
      "source": "heygen-com/hyperframes",
      "skills": [
        "hyperframes", "hyperframes-core", "hyperframes-animation", "hyperframes-creative", "hyperframes-keyframes", "hyperframes-cli",
        "hyperframes-registry", "hyperframes-audio", "hyperframes-studio", "media-use", "motion-graphics", "general-video"
      ]
    }
  ]
}
